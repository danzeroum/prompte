# Configuração do frontend.
# A API é o backend próprio (mesma origem). VITE_API_URL é o caminho base; o
# default /api funciona em dev (proxy do Vite) e em prod (Caddy roteia /api → api).
# Copie para .env:  cp .env.example .env
VITE_API_URL=/api

# (Dev) alvo do proxy /api quando rodar `npm run dev`. Default: http://localhost:8787
# API_PROXY_TARGET=http://localhost:8787
