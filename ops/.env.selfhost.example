# Self-host na VPS — copie para ops/.env.selfhost e preencha. NÃO commitar o real.
# (Cresce a cada PR: PR-A define o Postgres; api/JWT/LLM/Caddy vêm depois.)

# ── Postgres ──
POSTGRES_USER=prompte
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=prompte

# ── API / Auth ──
# Segredo do JWT (obrigatório). Gere algo longo, ex.: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-aleatorio-longo
# E-mails admin (CSV) que enxergam /api/metrics:
ADMIN_EMAILS=voce@exemplo.com
# Tamanho mínimo de senha no cadastro (default 8):
# PASSWORD_MIN_LENGTH=8

# ── Backup do Postgres ──
# Intervalo entre dumps (segundos; default 86400 = 1 dia) e quantos manter (default 7):
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP=7

# ── LLM (opcional; sem chave, /api/llm responde 503) ──
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ── Conexão GitHub (opcional; sem clientId/secret a feature fica desligada) ──
# Crie uma OAuth App em https://github.com/settings/developers (ou na sua Org):
#   - Homepage URL:               https://prompte.exemplo.com
#   - Authorization callback URL: https://prompte.exemplo.com/api/github/callback
# Depois preencha:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# URL absoluta do callback (igual à registrada na OAuth App):
GITHUB_CALLBACK_URL=https://prompte.exemplo.com/api/github/callback
# Base para onde o callback devolve o navegador (origem do app):
GITHUB_APP_BASE_URL=https://prompte.exemplo.com
# Escopo OAuth: 'repo' (lê repositórios privados) ou 'public_repo' (só públicos):
# GITHUB_SCOPE=repo
# Chave dedicada p/ cifrar o token em repouso (default: JWT_SECRET). Ex.: openssl rand -hex 32
# GITHUB_TOKEN_KEY=

# ── Caddy (HTTPS) ──
# Domínio com registro DNS A apontando para o IP da VPS:
DOMAIN=prompte.exemplo.com
# E-mail para o certificado Let's Encrypt:
ACME_EMAIL=voce@exemplo.com
