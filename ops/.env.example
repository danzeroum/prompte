# Copie para ops/.env e preencha. Não commitar o ops/.env real.
# Domínio que aponta (registro DNS A) para o IP da VPS:
DOMAIN=prompte.buildtovalue.cloud
# E-mail para o certificado Let's Encrypt (avisos de expiração):
ACME_EMAIL=danniellau@gmail.com

# Host do projeto Supabase para o Caddy proxiar o caminho /sb (auth/rest/functions).
# É só o host, sem https:// e sem barra final.
SUPABASE_HOST=tqohthmeneaweuozuref.supabase.co

# (Opcional) sobrescrever o projeto Supabase no build do frontend.
# Em deploy interno, aponte a URL para o próprio domínio + /sb (mesma origem),
# para que o navegador nunca chame *.supabase.co diretamente.
# VITE_SUPABASE_URL=https://prompte.buildtovalue.cloud/sb
# VITE_SUPABASE_ANON_KEY=eyJ...
