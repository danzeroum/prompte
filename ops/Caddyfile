# Caddy: HTTPS automático (Let's Encrypt) + proxy para o container do frontend.
# DOMAIN e ACME_EMAIL vêm do ambiente (ops/.env).
{$DOMAIN} {
	encode zstd gzip
	tls {$ACME_EMAIL}

	# Cabeçalhos de segurança (recomendação M4). Caddy termina o TLS, então é a
	# camada autoritativa para HSTS no deploy em VPS. Complementam a CSP via
	# <meta http-equiv> nos HTMLs.
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Proxy interno para o Supabase (auth/rest/functions). O navegador fala só com
	# este domínio (mesma origem); o Caddy encaminha para o Supabase reescrevendo o
	# Host para o gateway roteá-lo. Assim nenhuma requisição vai direto a *.supabase.co.
	# SUPABASE_HOST vem do ambiente (ops/.env), ex.: tqohthmeneaweuozuref.supabase.co.
	handle_path /sb/* {
		reverse_proxy https://{$SUPABASE_HOST} {
			header_up Host {$SUPABASE_HOST}
		}
	}

	reverse_proxy frontend:80
}
