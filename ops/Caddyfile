# Caddy: HTTPS automático (Let's Encrypt) + proxy para o container do frontend.
# DOMAIN e ACME_EMAIL vêm do ambiente (ops/.env).
{$DOMAIN} {
	encode zstd gzip
	tls {$ACME_EMAIL}

	# Cabeçalhos de segurança (recomendação M4). Caddy termina o TLS, então é a
	# camada autoritativa para HSTS no deploy em VPS. Complementam a CSP via
	# <meta http-equiv> nos HTMLs.
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy frontend:80
}
